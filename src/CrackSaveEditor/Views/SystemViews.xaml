<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels"
                    xmlns:core="clr-namespace:CrackSaveEditor.Core">

    <DataTemplate x:Key="SettingSlider" DataType="{x:Type vm:SettingSliderVm}">
        <Grid Margin="0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent2}" FontFamily="{StaticResource Mono}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GameSettingsVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,6,28,28">
                <DockPanel Margin="0,0,0,20">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ReloadCommand}" Content="{l:T 'Discard'}" Margin="0,0,8,0"/>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13"/>
                                <TextBlock Text="{l:T 'Save settings'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:T 'Game Settings'}" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Text="{l:T 'settings.json – independent of the save. Allows values the in-game menu does not (e.g. FOV above 120°).'}"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Camera &amp; Controls'}" Style="{StaticResource H2}"/>
                                <ItemsControl ItemsSource="{Binding Camera}" ItemTemplate="{StaticResource SettingSlider}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Audio" Style="{StaticResource H2}"/>
                                <ItemsControl ItemsSource="{Binding Audio}" ItemTemplate="{StaticResource SettingSlider}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Graphics'}" Style="{StaticResource H2}"/>
                                <TextBlock Text="{l:T 'DISPLAY MODE'}" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding DisplayMode}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Quality}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SettingSliderVm}">
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent2}" FontFamily="{StaticResource Mono}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Language'}" Style="{StaticResource H2}"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Options'}" Style="{StaticResource H2}"/>
                                <ItemsControl ItemsSource="{Binding Toggles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SettingToggleVm}">
                                            <StackPanel Margin="0,6">
                                                <CheckBox IsChecked="{Binding Value}" Content="{Binding Label}"/>
                                                <TextBlock Text="{Binding Hint}" Margin="48,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BackupsVm}">
        <Grid Margin="28,6,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenFolderCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Backup folder'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CreateCommand}" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Back up now'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Backups &amp; Slots" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding BackupDir}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="18,14,18,8">
                    <DataGrid ItemsSource="{Binding Backups}" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T 'CREATED'}" Binding="{Binding Created, StringFormat='G'}" Width="150"/>
                            <DataGridTextColumn Header="SLOT" Binding="{Binding SlotText}" Width="70"/>
                            <DataGridTextColumn Header="{l:T 'REASON'}" Binding="{Binding Label}" Width="*"/>
                            <DataGridTextColumn Header="{l:T 'SIZE'}" Binding="{Binding SizeText}" Width="80"/>
                            <DataGridTemplateColumn Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type core:BackupInfo}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{l:T 'Restore'}" Padding="10,3" FontSize="12" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                            <Button Content="&#xE74D;" FontFamily="{StaticResource Icons}" Padding="8,3" FontSize="12" Style="{StaticResource DangerButton}" ToolTip="{l:T 'Delete'}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Copy slot'}" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,-6,0,12" Text="{l:T 'Great for experiments: duplicate a save and mess around in the copy.'}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding SlotNames}" SelectedItem="{Binding CopyFrom}"/>
                                    <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource Icons}" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SlotNames}" SelectedItem="{Binding CopyTo}"/>
                                </Grid>
                                <Button Command="{Binding CopySlotCommand}" Content="{l:T 'Copy'}" Margin="0,12,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Slot tools'}" Style="{StaticResource H2}"/>
                                <ComboBox ItemsSource="{Binding SlotNames}" SelectedItem="{Binding ToolSlot}" Margin="0,0,0,12"/>
                                <Button Command="{Binding ResetToBaselineCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13"/>
                                        <TextBlock Text="{l:T 'Reset to day 0 (baseline)'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteSlotCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/>
                                        <TextBlock Text="{l:T 'Delete slot'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="{l:T 'Every action first backs up the affected slot.'}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
