<Window x:Class="CrackSaveEditor.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14"
            Margin="16" MinWidth="380" MaxWidth="620">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel Margin="24,22">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}"/>
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20"/>
            <ItemsControl x:Name="ChangeList" Margin="0,12,0,0" Visibility="Collapsed" MaxHeight="320">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border Background="{StaticResource Input}" CornerRadius="8" Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Area}" Foreground="{StaticResource Accent2}" FontSize="11.5"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="12">
                                <Run Text="{Binding Original, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                <Run Text=" → " Foreground="{StaticResource Muted}"/>
                                <Run Text="{Binding Current, Mode=OneWay}" Foreground="{StaticResource Success}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
