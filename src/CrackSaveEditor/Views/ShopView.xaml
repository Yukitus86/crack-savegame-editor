<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:ShopVm}">
        <Grid Margin="28,6,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Shop" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="{Binding Subtitle}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Stock -->
                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="18,16,18,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Command="{Binding RestockCommand}" Content="{l:T 'Restock all'}" Style="{StaticResource ChipButton}" Margin="0"/>
                            <TextBlock Text="{l:T 'Stock'}" Style="{StaticResource H2}" Margin="0"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Stocks}" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T 'ITEM'}" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{l:T 'CATALOG'}" Binding="{Binding Catalog}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{l:T 'PRICE'}" Binding="{Binding PriceText}" Width="90" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="{l:T 'IN STOCK'}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding Remaining, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GridTextBox}" Width="60" MinWidth="0"/>
                                                <TextBlock Text="{Binding MaxPurchases, StringFormat=' / {0}'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Sales -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Daily deals'}" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,-6,0,12" Text="{l:T 'Discounts last until the game rolls new deals the next day. 100 % = free.'}"/>
                                <ItemsControl ItemsSource="{Binding Sales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SaleVm}">
                                            <Border Background="{StaticResource Input}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE711;" FontFamily="{StaticResource Icons}" ToolTip="{l:T 'Remove deal'}"
                                                                Command="{Binding DataContext.RemoveSaleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="54"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Discount}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Discount, StringFormat={}{0} %}" HorizontalAlignment="Right" Foreground="{StaticResource Accent2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding PriceText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{l:T 'NEW DEAL'}" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                                <ComboBox ItemsSource="{Binding AllItems}" SelectedItem="{Binding NewSaleItem}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding NewSaleDiscount}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NewSaleDiscount, StringFormat={}{0} %}" HorizontalAlignment="Right" Foreground="{StaticResource Accent2}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Command="{Binding AddSaleCommand}" Content="{l:T 'Add deal'}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding SaleEverythingCommand}" Content="{l:T 'Put everything on sale'}" ToolTip="{l:T 'Applies the chosen discount to every item.'}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding ToolboxNotYetBought}" Content="{l:T 'Toolbox counts as not yet bought'}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="48,4,0,0" Text="{l:T 'Controls the toolbox intro hint in the shop.'}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
