<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:ItemsVm}">
        <Grid Margin="28,6,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{l:T 'Items &amp; Tools'}" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="{Binding Summary}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="18,14,18,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Command="{Binding RepairAllCommand}" Style="{StaticResource ChipButton}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="12"/>
                                    <TextBlock Text="{l:T 'Repair all tools'}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Grid VerticalAlignment="Center">
                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,9,6"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="ITEM" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PrefabName}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{l:T 'DURABILITY'}" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Visibility="{Binding HasDurability, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Durability, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource GridTextBox}" MinWidth="0"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding DurabilityPercent, Mode=OneWay}" Maximum="100" Height="5"/>
                                                    <TextBlock Text="{Binding MaxDurability, StringFormat='max {0}'}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T 'LOCATION'}" Binding="{Binding Location}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{l:T 'ORIGIN'}" Binding="{Binding Origin}" Width="85" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Selection'}" Style="{StaticResource H2}"/>
                                <TextBlock Text="{l:T 'Select an item on the left.'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel DataContext="{Binding Selected}">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
                                    <TextBlock Text="{Binding Properties}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <Button Command="{Binding DuplicateCommand}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/>
                                            <TextBlock Text="{l:T 'Duplicate'}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/>
                                            <TextBlock Text="{l:T 'Delete'}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Spawn item'}" Style="{StaticResource H2}"/>
                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,10" Padding="8,1">
                                        <TextBlock Text="{l:T 'Experimental'}" FontSize="10.5" Foreground="{StaticResource Accent2}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,-4,0,12"
                                           Text="{l:T 'The new item appears next to the selected (or first) item when you load the save. Tools spawn at full durability.'}"/>
                                <ComboBox ItemsSource="{Binding SpawnOptions}" SelectedItem="{Binding SpawnChoice}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SpawnCount}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpawnCount, StringFormat={}{0}×}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent2}"/>
                                </Grid>
                                <Button Command="{Binding SpawnCommand}" Style="{StaticResource AccentButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13"/>
                                        <TextBlock Text="{l:T 'Spawn'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
