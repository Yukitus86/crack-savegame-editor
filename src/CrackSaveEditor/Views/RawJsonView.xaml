<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:RawJsonVm}">
        <Grid Margin="28,6,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ImportCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Import JSON'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Export decrypted'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Raw JSON" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{l:T 'For power users: every value of the decrypted save. Types are preserved (number, text, true/false).'}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Margin="0" Padding="10">
                    <TreeView ItemsSource="{Binding Roots}" VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:JsonTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource Accent2}" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                                    <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12.5" Margin="10,0,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Edit value'}" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding SelectedPath}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-4,0,10"/>
                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" MinHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top" IsReadOnly="{Binding CanEdit, Converter={StaticResource InvertBool}}"/>
                                <Button Command="{Binding ApplyCommand}" Style="{StaticResource AccentButton}" Content="{l:T 'Apply'}" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="{l:T 'Objects and lists are read-only – expand them and pick a single value.'}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T 'Search'}" Style="{StaticResource H2}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding SearchCommand}" Content="&#xE721;" FontFamily="{StaticResource Icons}" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T 'Key or value, e.g. balance, durability, Pickaxe'}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <TextBlock Text="{Binding SearchInfo}" Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
                                <ListBox ItemsSource="{Binding Hits}" SelectedItem="{Binding Hit}" MaxHeight="360">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Path}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Accent2}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
