<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:WorldVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,6,28,28">
                <TextBlock Text="{l:T 'World &amp; Work Order'}" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20" Text="{l:T 'Day, playtime, the egg mood, burst pipes and the current work order.'}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'DAY'}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Day, UpdateSourceTrigger=LostFocus}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T 'As shown in-game. Affects events and the shift schedule.'}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'PLAYTIME (HOURS)'}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding PlayHours, StringFormat=N2, UpdateSourceTrigger=LostFocus}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlayTimeText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'WORLD SEED'}" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="&#xE8C8;" FontFamily="{StaticResource Icons}"
                                        Command="{Binding CopySeedCommand}" ToolTip="{l:T 'Copy'}"/>
                                <TextBlock Text="{Binding WorldSeed}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding RunId, StringFormat='Run {0}'}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Agitation -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CalmCommand}" Style="{StaticResource ChipButton}" Margin="0" Content="{l:T 'Calm the egg (0 %)'}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Egg agitation'}" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,-4,0,14"
                                   Text="{l:T 'Every dig makes the creature inside the egg more restless. The higher the value, the sooner something nasty happens.'}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="{Binding MaxAgitation}" Value="{Binding Agitation}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Agitation, StringFormat=N1}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent2}"/>
                                <TextBlock Text="{Binding AgitationText}" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{l:T 'Calming steps already used this cycle'}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <TextBox Text="{Binding CalmStepsUsed, UpdateSourceTrigger=LostFocus}" Width="70" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Work order -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding CompleteStepCommand}" Style="{StaticResource AccentButton}" Content="{l:T 'Complete step'}"
                                    ToolTip="{l:T 'Sets progress to the target. The game advances to the next step when loading.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Accent2}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding StepText}" FontSize="16" Margin="0,4,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Value="{Binding StepPercent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <TextBox Text="{Binding StepProgress, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <TextBlock Text="{Binding StepTarget, StringFormat=' / {0}'}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0">
                            <Run Text="{l:T 'Last completed: '}"/><Run Text="{Binding CompletedText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Pipes -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Command="{Binding RepairPipesCommand}" Style="{StaticResource ChipButton}" Margin="0" Content="{l:T 'Seal all &amp; drain'}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Info}" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T 'Burst pipes'}" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Pipes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PipeVm}">
                                    <CheckBox IsChecked="{Binding Leaking}" Margin="0,4">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{l:T ' leaking'}" Foreground="{StaticResource Muted}"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{l:T 'Flood water level'}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <TextBox Text="{Binding FloodDepth, StringFormat=N2, UpdateSourceTrigger=LostFocus}" Width="90" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
