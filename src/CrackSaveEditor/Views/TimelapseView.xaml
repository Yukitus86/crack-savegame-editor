<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:TimelapseVm}">
        <Grid Margin="28,6,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenFolderCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Folder'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GifCommand}" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE786;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Export as GIF'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T 'Timelapse'}" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding Summary}"/>
                </StackPanel>
            </DockPanel>

            <!-- Preview -->
            <Border Grid.Row="1" CornerRadius="14" Background="#08090B" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Background="#CC0D0E11" CornerRadius="8" Padding="10,5">
                        <TextBlock Text="{Binding Selected.Label}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Controls -->
            <DockPanel Grid.Row="2" Margin="0,12">
                <Button Command="{Binding PlayCommand}" Style="{StaticResource AccentButton}" Width="44" Height="36" Padding="0">
                    <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource Icons}" FontSize="14"/>
                </Button>
                <TextBlock Text="{Binding SpeedText}" DockPanel.Dock="Right" VerticalAlignment="Center" Width="80" TextAlignment="Right" Foreground="{StaticResource Muted}"/>
                <Slider DockPanel.Dock="Right" Minimum="1" Maximum="30" Value="{Binding Speed}" Width="180" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="{l:T 'Speed'}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="20,0,0,0"/>
                <Border/>
            </DockPanel>

            <!-- Filmstrip -->
            <ListBox Grid.Row="3" ItemsSource="{Binding Frames}" SelectedItem="{Binding Selected}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FrameVm}">
                        <StackPanel Width="150">
                            <Border CornerRadius="6" ClipToBounds="True" Height="84">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="2,5,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
