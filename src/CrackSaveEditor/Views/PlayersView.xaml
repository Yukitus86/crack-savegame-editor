<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:PlayersVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,6,28,28">
                <TextBlock Text="{l:T 'Players'}" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20" Text="{l:T 'Crew members, sleep stats, tips, handbook and announcements.'}"/>

                <ItemsControl ItemsSource="{Binding Players}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlayerVm}">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SteamId, StringFormat='SteamID {0}'}" Style="{StaticResource MutedText}" Margin="0,2,0,14"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{l:T 'Nights in bed'}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Width="140"/>
                                            <TextBox Text="{Binding NightsInBed, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                        </StackPanel>
                                        <DockPanel Margin="0,14,0,0">
                                            <Button DockPanel.Dock="Right" Command="{Binding ResetTipsCommand}" Style="{StaticResource ChipButton}" Margin="10,0,0,0" Content="{l:T 'Reset tips'}" VerticalAlignment="Top"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TipsSeenText}"/>
                                                <TextBlock Text="{Binding TipsText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:T 'LIFETIME SHIFT STATS'}" Style="{StaticResource Label}"/>
                                        <ItemsControl ItemsSource="{Binding Lifetime}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Input}" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="11.5"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Handbook entries'}" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,-6,0,12" Text="{l:T 'Employee handbook entries that are already revealed (e.g. layer:EggMembrane, event:PizzaPartyEvent).'}"/>
                            <ItemsControl ItemsSource="{Binding Revealed}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoft}" CornerRadius="999" Padding="10,2,4,2" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Accent2}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource GhostButton}" Padding="4,2" Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="9"
                                                        Command="{Binding DataContext.RemoveRevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Command="{Binding AddRevealCommand}" Content="{l:T 'Add'}" Margin="8,0,0,0"/>
                                <TextBox Text="{Binding NewReveal, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Crew" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Total nights'}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Width="140"/>
                                    <TextBox Text="{Binding BedNights, UpdateSourceTrigger=LostFocus}" Width="80"/>
                                </StackPanel>
                                <TextBlock Text="{l:T 'EVENTS'}" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                                <TextBlock Text="{Binding EventsText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{l:T 'SOLD RESOURCES'}" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                                <TextBlock Text="{Binding SoldText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ResetAnnouncementsCommand}" Style="{StaticResource ChipButton}" Margin="10,0,0,0" Content="{l:T 'Reset'}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{l:T 'Announcement history'}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                        <Run Text="{Binding AnnouncementCount, Mode=OneWay}"/><Run Text="{l:T ' announcements played. Reset to hear them all again.'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RunVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,6,28,28">
                <TextBlock Text="Run &amp; Ranking" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20"
                           Text="{l:T 'The run record (.run) decides whether this save counts for the Steam leaderboards. It is shown here for information only.'}"/>
                <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding RankedText}" Style="{StaticResource BigNumber}">
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{l:T 'RUN TIME'}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding Elapsed}" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T 'PROGRESS'}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding FinishedText}" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{l:T 'MAX CREW'}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding MaxCrew}" Style="{StaticResource BigNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,20,0,0">
                            <TextBlock Style="{StaticResource MutedText}"><Run Text="{l:T 'Run ID: '}"/><Run Text="{Binding RunId, Mode=OneWay}" FontFamily="{StaticResource Mono}"/></TextBlock>
                            <TextBlock Style="{StaticResource MutedText}"><Run Text="{l:T 'Unranked reason: '}"/><Run Text="{Binding UnrankedReason, Mode=OneWay}"/></TextBlock>
                            <TextBlock Style="{StaticResource MutedText}"><Run Text="{l:T 'Signed for: '}"/><Run Text="{Binding HostText, Mode=OneWay}"/><Run Text="{l:T '  ·  File: '}"/><Run Text="{Binding RunFile, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Editor used = unranked'}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="26,6,0,0"
                                   Text="{l:T 'As soon as the editor writes a slot (save, copy slot, reset to day 0, restore backup) the run is marked unranked. This cannot be turned off – it keeps the Steam leaderboards fair. Nothing changes for your own playthrough.'}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
