<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <DataTemplate DataType="{x:Type vm:FinanceVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,6,28,28">
                <TextBlock Text="{l:T 'Finances'}" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,20"
                           Text="{l:T 'Balances are stored in cents – here you edit them in dollars. The slot summary in the game menu is updated automatically.'}"/>

                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountVm}">
                            <Border Style="{StaticResource CardBorder}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentGradient}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="#1A0E05"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" FontSize="16" FontWeight="SemiBold"
                                                 Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" MinWidth="200"
                                                 ToolTip="{l:T 'Display name stored in the save'}"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0">
                                            <Run Text="SteamID "/><Run Text="{Binding SteamId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{l:T 'BALANCE'}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding BalanceText}" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Success}"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{l:T 'BALANCE ($)'}" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Balance, StringFormat=N2, UpdateSourceTrigger=LostFocus}" FontSize="15"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{l:T 'TOTAL INCOME ($)'}" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Income, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{l:T 'TOTAL EXPENSES ($)'}" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding Expenses, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding AddCommand}" CommandParameter="100" Content="{l:T '+ $100'}"/>
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding AddCommand}" CommandParameter="1000" Content="{l:T '+ $1,000'}"/>
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding AddCommand}" CommandParameter="10000" Content="{l:T '+ $10,000'}"/>
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding AddCommand}" CommandParameter="100000" Content="{l:T '+ $100,000'}"/>
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding AddCommand}" CommandParameter="-1000" Content="{l:T '− $1,000'}"/>
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding MaxCommand}"
                                                Content="{Binding DataContext.MaxText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <Button Style="{StaticResource ChipButton}" Command="{Binding StartCommand}"
                                                Content="{Binding DataContext.StartText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Total shop spending'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T 'Sum of all crew purchases. The game uses it for stats and unlocks.'}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding GlobalShopSpending, StringFormat=N2, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
