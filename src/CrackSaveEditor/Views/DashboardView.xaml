<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
                    xmlns:vm="clr-namespace:CrackSaveEditor.ViewModels">

    <!-- Slot card -->
    <Style x:Key="SlotCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="B" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SlotCard" DataType="{x:Type vm:SlotCardVm}">
        <Button Style="{StaticResource SlotCardButton}" Margin="0,0,14,0"
                Command="{Binding DataContext.OpenSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Thumbnail -->
                <Border CornerRadius="13,13,0,0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A1A10" Offset="0"/>
                            <GradientStop Color="#15171C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource Icons}" FontSize="42" Foreground="#33FF8A3D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="13,13,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="60">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#CC0D0E11" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10">
                            <Border Style="{StaticResource Pill}" Background="#CC0D0E11" Margin="6,0,0,0"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:T 'Loaded'}" Foreground="{StaticResource Accent2}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#CC0D0E11" Margin="6,0,0,0"
                                    Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Ranked}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRanked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="16,0,0,10" Foreground="White"/>
                    </Grid>
                </Border>

                <!-- Details -->
                <StackPanel Grid.Row="1" Margin="16,12,16,16">
                    <StackPanel Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="{l:T 'DAY'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding Day}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T 'BALANCE'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding Balance}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T 'PLAYTIME'}" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding PlayTime}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                            <Run Text="&#xE716;" FontFamily="{StaticResource Icons}"/> <Run Text="{Binding Players, Mode=OneWay}"/>
                            <Run Text="   &#xE823;" FontFamily="{StaticResource Icons}"/> <Run Text="{Binding LastWrite, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Exists}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{l:T 'Empty slot'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{l:T 'Start a new game in this slot in-game.'}" Style="{StaticResource MutedText}" Margin="0,4,0,18"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DashboardVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,6,28,28">
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13"/>
                            <TextBlock Text="{l:T 'Save folder'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{l:T 'Welcome back, shift worker.'}" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                            <Run Text="{l:T 'Pick a save. Everything is decrypted, edited and cleanly re-signed with your SteamID.'}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotCard}" Margin="0,0,-14,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Quick actions -->
                <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasSlot, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding GodCommand}" Padding="16,9"
                                    ToolTip="{l:T 'Max money, all upgrades, tools repaired, egg calmed, pipes sealed, shop restocked.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14"/>
                                    <TextBlock Text="{l:T 'Max everything'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveTitle}" Style="{StaticResource H2}" Margin="0"/>
                                <TextBlock Text="{l:T 'One click – changes are queued and only written when you hit Save.'}" Style="{StaticResource MutedText}" Margin="0,3,0,14"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding MoneyCommand}" CommandParameter="1000" Content="{l:T '+ $1,000'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding MoneyCommand}" CommandParameter="10000" Content="{l:T '+ $10,000'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding MoneyCommand}" CommandParameter="100000" Content="{l:T '+ $100,000'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding RepairCommand}" Content="{l:T 'Repair tools'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding ScannerCommand}" Content="{l:T 'Max scanner'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding BotsCommand}" Content="{l:T 'Bots to max level'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding UnlockCommand}" Content="{l:T 'Unlock all garages'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding CalmCommand}" Content="{l:T 'Calm the egg'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding PipesCommand}" Content="{l:T 'Fix pipes'}"/>
                            <Button Style="{StaticResource ChipButton}" Command="{Binding RestockCommand}" Content="{l:T 'Restock shop'}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Tips -->
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Accent2}"/>
                            <TextBlock Text="{l:T 'Close the game first'}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="{l:T 'CRACK saves when it quits and would overwrite your changes. The sidebar shows whether the game is running.'}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Success}"/>
                            <TextBlock Text="{l:T 'Automatic backups'}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="{l:T 'Every save first writes a ZIP to the Backups folder next to the EXE. Restore them under Backups &amp; Slots.'}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Info}"/>
                            <TextBlock Text="{l:T 'Play fair'}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="{l:T 'Every save the editor writes is marked unranked, so the Steam leaderboards stay clean.'}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
