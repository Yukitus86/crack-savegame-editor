<Window x:Class="CrackSaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:CrackSaveEditor.Core"
        Title="CRACK Savegame Editor" Icon="Resources/app.ico"
        Width="1320" Height="860" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,0,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="52" Margin="4,8,0,10">
                        <Image Source="Resources/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CRACK" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="Savegame Editor" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Game status -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Card}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="GameDot" Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GameText" Margin="8,0,0,0" FontSize="12.5"/>
                            </StackPanel>
                            <TextBlock x:Name="GameHint" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="16,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Editor language -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{l:T 'EDITOR LANGUAGE'}" Style="{StaticResource Label}" Margin="12,0,0,6"/>
                        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="3">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="LangEn" Style="{StaticResource SegmentItem}" Content="English" GroupName="EditorLang" Checked="Language_Checked"/>
                                <RadioButton x:Name="LangDe" Style="{StaticResource SegmentItem}" Content="Deutsch" GroupName="EditorLang" Checked="Language_Checked"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Nav">
                            <TextBlock Text="{l:T 'OVERVIEW'}" Style="{StaticResource Label}" Margin="12,6,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard" x:Name="NavDashboard" IsChecked="True"/>

                            <TextBlock Text="{l:T 'SAVE GAME'}" Style="{StaticResource Label}" Margin="12,16,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8C7;" Content="{l:T 'Finances'}" x:Name="NavFinance" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE74A;" Content="Upgrades" x:Name="NavUpgrades" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE719;" Content="Shop" x:Name="NavShop" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="{l:T 'Items &amp; Tools'}" x:Name="NavItems" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE909;" Content="{l:T 'World &amp; Work Order'}" x:Name="NavWorld" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE716;" Content="{l:T 'Players'}" x:Name="NavPlayers" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE916;" Content="Run &amp; Ranking" x:Name="NavRun" IsEnabled="{Binding HasSlot}"/>

                            <TextBlock Text="EXTRAS" Style="{StaticResource Label}" Margin="12,16,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE714;" Content="{l:T 'Timelapse'}" x:Name="NavTimelapse" IsEnabled="{Binding HasSlot}"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE943;" Content="Raw JSON" x:Name="NavRaw" IsEnabled="{Binding HasSlot}"/>

                            <TextBlock Text="SYSTEM" Style="{StaticResource Label}" Margin="12,16,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{l:T 'Game Settings'}" x:Name="NavSettings"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE777;" Content="Backups &amp; Slots" x:Name="NavBackups"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ Main ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <DockPanel Margin="24,0,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"/>
                        <Button Style="{StaticResource TitleBarButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click" x:Name="CloseButton"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding HasSlot, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip="{l:T 'Saves written by the editor no longer count for the Steam leaderboards. This cannot be turned off.'}">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T 'Saving = unranked'}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Margin="16,0,8,0" Command="{Binding ReloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l:T 'Reload (F5) – discards changes'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="{l:T 'Reload'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l:T 'Save (Ctrl+S) – creates a backup first'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13"/>
                                <TextBlock Text="{l:T 'Save'}" Margin="8,0,0,0"/>
                                <Border Background="#1A0E05" CornerRadius="9" Padding="7,0" Margin="8,0,0,0"
                                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Changes.Count}" Foreground="{StaticResource Accent2}" FontSize="11.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Visibility="{Binding HasSlot, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SlotTitle}" Foreground="{StaticResource Accent2}" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding SignatureText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Page host -->
                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

                <!-- Status bar -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Muted}">
                            <Run Text="{l:T 'Ctrl+S save · F5 reload · v'}"/><Run x:Name="VersionRun"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
