<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CrackSaveEditor</AssemblyName>
    <RootNamespace>CrackSaveEditor</RootNamespace>
    <Version>1.2.0</Version>
    <Product>CRACK Savegame Editor</Product>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single-file, self-contained publish (see publish.ps1) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\GameData.json" LogicalName="GameData.json" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

</Project>
